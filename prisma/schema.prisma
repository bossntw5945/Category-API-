
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  price     Float
  stock     Int      @default(0)
  createdAt DateTime @default(now())
}